msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "ORCID manual (editable)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Restaura o campo ORCID editable cando a autenticación ORCID (OAuth) non está configurada, como nas versións anteriores de OJS: no formulario de autoría/colaboración, na páxina pública de rexistro e no perfil da persoa usuaria. Non ten efecto cando ORCID OAuth está activo."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Introduza o ORCID iD completo, no formato https://orcid.org/0000-0002-1825-0097 (ou só os 16 díxitos)."

msgid "plugins.generic.orcidManualEntry.error.duplicateOrcid"
msgstr "Este ORCID iD xa está asignado a outro colaborador deste envío ({$name})."

msgid "plugins.generic.orcidManualEntry.settings.intro"
msgstr "Estas opcións só se aplican mentres a autenticación ORCID (OAuth) non estea configurada nesta revista."

msgid "plugins.generic.orcidManualEntry.settings.area.where"
msgstr "Onde aparece o campo"

msgid "plugins.generic.orcidManualEntry.settings.showOnRegistration"
msgstr "Amosar o campo ORCID na páxina pública de rexistro"

msgid "plugins.generic.orcidManualEntry.settings.area.required"
msgstr "Onde o iD é obrigatorio"

msgid "plugins.generic.orcidManualEntry.settings.area.required.description"
msgstr "O iD ORCID obrigatorio esíxese coa mesma validación que o opcional: o formato e o díxito de control séguense comprobando."

msgid "plugins.generic.orcidManualEntry.settings.requireOnRegistration"
msgstr "Esixilo para rexistrar unha conta nova"

msgid "plugins.generic.orcidManualEntry.settings.requireOnContributor"
msgstr "Esixilo para gardar un autor ou coautor"

msgid "plugins.generic.orcidManualEntry.settings.requireOnSubmit"
msgstr "Esixilo a todos os autores para completar o envío"

msgid "plugins.generic.orcidManualEntry.error.requiredOnRegistration"
msgstr "O iD ORCID é obrigatorio para se rexistrar."

msgid "plugins.generic.orcidManualEntry.error.requiredOnContributor"
msgstr "O iD ORCID é obrigatorio para cada autor e coautor."

msgid "plugins.generic.orcidManualEntry.error.requiredOnSubmit"
msgstr "O envío non pode completarse mentres falte o iD ORCID de: {$names}."

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt"
msgstr "Os xestores da revista e os editores de sección quedan exentos"

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt.description"
msgstr "Poden gardar un autor e completar un envío co iD aínda ausente. O rexistro público non entra: quen se rexistra aínda non ten papel na revista."
