msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "Handmatige ORCID (invulbaar)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Herstelt het invulbare ORCID-veld wanneer ORCID-authenticatie (OAuth) niet is geconfigureerd, zoals in eerdere OJS-versies: in het formulier voor auteur/bijdrager, op de openbare registratiepagina en in het gebruikersprofiel. Heeft geen effect wanneer ORCID OAuth actief is."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Voer de volledige ORCID iD in, in de notatie https://orcid.org/0000-0002-1825-0097 (of alleen de 16 cijfers)."
