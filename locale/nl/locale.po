msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "Handmatige ORCID (invulbaar)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Herstelt het invulbare ORCID-veld wanneer ORCID-authenticatie (OAuth) niet is geconfigureerd, zoals in eerdere OJS-versies: in het formulier voor auteur/bijdrager, op de openbare registratiepagina en in het gebruikersprofiel. Heeft geen effect wanneer ORCID OAuth actief is."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Voer de volledige ORCID iD in, in de notatie https://orcid.org/0000-0002-1825-0097 (of alleen de 16 cijfers)."

msgid "plugins.generic.orcidManualEntry.error.duplicateOrcid"
msgstr "Deze ORCID iD is al toegewezen aan een andere bijdrager van deze inzending ({$name})."

msgid "plugins.generic.orcidManualEntry.settings.intro"
msgstr "Deze instellingen gelden alleen zolang ORCID-authenticatie (OAuth) niet is ingesteld voor dit tijdschrift."

msgid "plugins.generic.orcidManualEntry.settings.area.where"
msgstr "Waar het veld wordt getoond"

msgid "plugins.generic.orcidManualEntry.settings.showOnRegistration"
msgstr "Toon het ORCID-veld op de openbare registratiepagina"

msgid "plugins.generic.orcidManualEntry.settings.area.required"
msgstr "Waar de iD verplicht is"

msgid "plugins.generic.orcidManualEntry.settings.area.required.description"
msgstr "Een verplichte ORCID iD wordt met dezelfde controle gevraagd als een optionele: formaat en controlecijfer blijven gelden."

msgid "plugins.generic.orcidManualEntry.settings.requireOnRegistration"
msgstr "Vereis het bij registratie van een nieuw account"

msgid "plugins.generic.orcidManualEntry.settings.requireOnContributor"
msgstr "Vereis het om een auteur of co-auteur op te slaan"

msgid "plugins.generic.orcidManualEntry.settings.requireOnSubmit"
msgstr "Vereis het van alle bijdragers om een inzending af te ronden"

msgid "plugins.generic.orcidManualEntry.error.requiredOnRegistration"
msgstr "De ORCID iD is verplicht om te registreren."

msgid "plugins.generic.orcidManualEntry.error.requiredOnContributor"
msgstr "De ORCID iD is verplicht voor elke auteur en co-auteur."

msgid "plugins.generic.orcidManualEntry.error.requiredOnSubmit"
msgstr "De inzending kan niet worden afgerond zolang de ORCID iD ontbreekt van: {$names}."
