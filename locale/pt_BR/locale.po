msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "ORCID manual (digitável)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Restaura o campo ORCID digitável quando a autenticação ORCID (OAuth) não está configurada, como nas versões anteriores do OJS: no formulário de autor/contribuidor, no cadastro público de usuário e no perfil do usuário. Sem efeito quando o ORCID OAuth está ativo."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Informe o iD ORCID completo, no formato https://orcid.org/0000-0002-1825-0097 (ou apenas os 16 dígitos)."

msgid "plugins.generic.orcidManualEntry.error.duplicateOrcid"
msgstr "Este ORCID iD já está atribuído a outro contribuidor desta submissão ({$name})."

msgid "plugins.generic.orcidManualEntry.settings.intro"
msgstr "Estas opções valem apenas enquanto a autenticação ORCID (OAuth) não estiver configurada nesta revista."

msgid "plugins.generic.orcidManualEntry.settings.area.where"
msgstr "Onde o campo aparece"

msgid "plugins.generic.orcidManualEntry.settings.showOnRegistration"
msgstr "Exibir o campo ORCID na página pública de cadastro"

msgid "plugins.generic.orcidManualEntry.settings.area.required"
msgstr "Onde o iD é obrigatório"

msgid "plugins.generic.orcidManualEntry.settings.area.required.description"
msgstr "O iD ORCID obrigatório é cobrado com a mesma validação do opcional: formato e dígito verificador continuam sendo conferidos."

msgid "plugins.generic.orcidManualEntry.settings.requireOnRegistration"
msgstr "Exigir no cadastro de novo usuário"

msgid "plugins.generic.orcidManualEntry.settings.requireOnContributor"
msgstr "Exigir no cadastro de autor ou coautor"

msgid "plugins.generic.orcidManualEntry.settings.requireOnSubmit"
msgstr "Exigir de todos os autores para concluir a submissão"

msgid "plugins.generic.orcidManualEntry.error.requiredOnRegistration"
msgstr "O iD ORCID é obrigatório para se cadastrar."

msgid "plugins.generic.orcidManualEntry.error.requiredOnContributor"
msgstr "O iD ORCID é obrigatório para todo autor e coautor."

msgid "plugins.generic.orcidManualEntry.error.requiredOnSubmit"
msgstr "A submissão não pode ser concluída enquanto faltar o iD ORCID de: {$names}."

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt"
msgstr "Gestores da revista e editores de seção ficam isentos"

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt.description"
msgstr "Eles podem gravar um autor e concluir uma submissão com o iD ainda faltando. O cadastro público não entra: quem se cadastra ainda não tem papel na revista."
