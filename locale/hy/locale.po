msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "Ձեռքով ORCID (մուտքագրելի)"

#, fuzzy
msgid "plugins.generic.orcidManualEntry.description"
msgstr "Վերականգնում է ձեռքով լրացվող ORCID դաշտը, երբ ORCID (OAuth) նույնականացումը կարգավորված չէ՝ ինչպես OJS-ի նախորդ տարբերակներում՝ հեղինակի/ներդրողի ձևում, հանրային գրանցման էջում և օգտվողի պրոֆիլում։ ORCID OAuth-ի ակտիվ լինելիս ազդեցություն չունի։"

#, fuzzy
msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Մուտքագրեք ամբողջական ORCID iD-ն՝ https://orcid.org/0000-0002-1825-0097 ձևաչափով (կամ միայն 16 թվանշանը)։"
