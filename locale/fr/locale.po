msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "ORCID manuel (saisissable)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Restaure le champ ORCID saisissable lorsque l'authentification ORCID (OAuth) n'est pas configurée, comme dans les versions précédentes d'OJS : dans le formulaire d'auteur/contributeur, sur la page d'inscription publique et dans le profil de l'utilisateur. Sans effet lorsque ORCID OAuth est actif."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Indiquez l'identifiant ORCID complet, au format https://orcid.org/0000-0002-1825-0097 (ou seulement les 16 chiffres)."
