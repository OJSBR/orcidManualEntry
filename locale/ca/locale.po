msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "ORCID manual (editable)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Restaura el camp ORCID editable quan l'autenticació ORCID (OAuth) no està configurada, com a les versions anteriors de l'OJS: al formulari d'autoria/col·laboració, a la pàgina pública de registre i al perfil de l'usuari. No té cap efecte quan l'ORCID OAuth és actiu."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Introduïu l'ORCID iD complet, en el format https://orcid.org/0000-0002-1825-0097 (o només els 16 dígits)."
