msgid "plugins.generic.orcidManualEntry.displayName"
msgstr "Manuelle ORCID (eingebbar)"

msgid "plugins.generic.orcidManualEntry.description"
msgstr "Stellt das eingebbare ORCID-Feld wieder her, wenn die ORCID-Authentifizierung (OAuth) nicht konfiguriert ist, wie in früheren OJS-Versionen: im Autoren-/Beitragendenformular, auf der öffentlichen Registrierungsseite und im Benutzerprofil. Ohne Wirkung, wenn ORCID OAuth aktiv ist."

msgid "plugins.generic.orcidManualEntry.field.description"
msgstr "Geben Sie die vollständige ORCID iD im Format https://orcid.org/0000-0002-1825-0097 an (oder nur die 16 Ziffern)."

msgid "plugins.generic.orcidManualEntry.error.duplicateOrcid"
msgstr "Diese ORCID iD ist bereits einem anderen Beitragenden dieser Einreichung zugeordnet ({$name})."

msgid "plugins.generic.orcidManualEntry.settings.intro"
msgstr "Diese Einstellungen gelten nur, solange die ORCID-Authentifizierung (OAuth) für diese Zeitschrift nicht eingerichtet ist."

msgid "plugins.generic.orcidManualEntry.settings.area.where"
msgstr "Wo das Feld erscheint"

msgid "plugins.generic.orcidManualEntry.settings.showOnRegistration"
msgstr "Das ORCID-Feld auf der öffentlichen Registrierungsseite anzeigen"

msgid "plugins.generic.orcidManualEntry.settings.area.required"
msgstr "Wo die iD Pflicht ist"

msgid "plugins.generic.orcidManualEntry.settings.area.required.description"
msgstr "Eine verpflichtende ORCID iD wird mit derselben Prüfung verlangt wie eine freiwillige: Format und Prüfziffer werden weiterhin kontrolliert."

msgid "plugins.generic.orcidManualEntry.settings.requireOnRegistration"
msgstr "Für die Registrierung eines neuen Kontos verlangen"

msgid "plugins.generic.orcidManualEntry.settings.requireOnContributor"
msgstr "Zum Speichern einer Autorin oder eines Mitautors verlangen"

msgid "plugins.generic.orcidManualEntry.settings.requireOnSubmit"
msgstr "Von allen Beitragenden für den Abschluss der Einreichung verlangen"

msgid "plugins.generic.orcidManualEntry.error.requiredOnRegistration"
msgstr "Für die Registrierung ist die ORCID iD erforderlich."

msgid "plugins.generic.orcidManualEntry.error.requiredOnContributor"
msgstr "Die ORCID iD ist für jede Autorin und jeden Mitautor erforderlich."

msgid "plugins.generic.orcidManualEntry.error.requiredOnSubmit"
msgstr "Die Einreichung kann nicht abgeschlossen werden, solange die ORCID iD fehlt von: {$names}."

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt"
msgstr "Zeitschriftenverwalter/innen und Rubrikredakteur/innen sind ausgenommen"

msgid "plugins.generic.orcidManualEntry.settings.editorsExempt.description"
msgstr "Sie können eine beitragende Person speichern und eine Einreichung abschließen, während die iD noch fehlt. Die öffentliche Registrierung ist nicht erfasst: wer sich registriert, hat noch keine Rolle in der Zeitschrift."
